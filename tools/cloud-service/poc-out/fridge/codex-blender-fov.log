/bin/zsh -lc "python3 - <<'PY'
import json
from PIL import Image, ImageChops

paths = {
    \"final\": \"tools/cloud-service/poc-out/fridge/stage-fridge-arch-final.png\",
    \"ref\": \"tools/cloud-service/poc-out/fridge/ref/fridge-ref-front-329c-1024.png\",
}
threshold = 16

def corners(image):
    return [
        image.getpixel((2, 2)),
        image.getpixel((image.width - 3, 2)),
        image.getpixel((2, image.height - 3)),
        image.getpixel((image.width - 3, image.height - 3)),
    ]

def background_color(image):
    corner_colors = corners(image)
    return tuple(sorted(color[channel] for color in corner_colors)[1] for channel in range(3))

def mask_area(image):
    background = background_color(image)
    mask = ImageChops.difference(image, Image.new(\"RGB\", image.size, background))
    return sum(pixel > threshold for pixel in mask.convert(\"L\").getdata())

images = {name: Image.open(path).convert(\"RGB\") for name, path in paths.items()}
for name, image in images.items():
    print(f\"{name}: size={image.size} corners={corners(image)} background={background_color(image)} mask_area={mask_area(image)}\")

metrics_path = \"tools/cloud-service/poc-out/fridge/arch-metrics.json\"
with open(metrics_path, encoding=\"utf-8\") as stream:
    metrics = json.load(stream)
metrics[\"mask_areas\"] = {name: mask_area(image) for name, image in images.items()}
metrics[\"corner_rgb\"] = {name: corners(image) for name, image in images.items()}
metrics[\"background_rgb\"] = {name: background_color(image) for name, image in images.items()}
with open(metrics_path, \"w\", encoding=\"utf-8\") as stream:
    json.dump(metrics, stream, indent=2)
    stream.write(\"\\n\")
