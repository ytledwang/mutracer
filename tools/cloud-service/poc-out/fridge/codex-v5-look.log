type Result<T> = std::result::Result<T, String>;

static CAD_OVERRIDE_LOGGED: AtomicUsize = AtomicUsize::new(0);

fn stage_to_render() -> Mat4 {
    Mat4::from_cols(
        glam::Vec4::new(1., 0., 0., 0.),
        glam::Vec4::new(0., 0., -1., 0.),
        glam::Vec4::new(0., 1., 0., 0.),
        glam::Vec4::new(0., 0., 0., 1.),
    )
}

fn gltf_to_ue() -> Mat4 {
    let s = match std::env::var("MUTRACER_GLTF_MAP").as_deref() {
        Ok("x-zy") => [1., 0., 0., 0., 0., -1., 0., 1., 0.],
        Ok("-xzy") => [-1., 0., 0., 0., 0., 1., 0., 1., 0.],
        Ok("xzy") => [1., 0., 0., 0., 0., 1., 0., 1., 0.],
        // Default (verified vs 可影 Front render): UE = (-z, x, y) of glTF.
        _ => [0., 0., -1., 1., 0., 0., 0., 1., 0.],
    };
    // rows: ue = M * gltf
    Mat4::from_cols(
        glam::Vec4::new(s[0], s[3], s[6], 0.),
        glam::Vec4::new(s[1], s[4], s[7], 0.),
        glam::Vec4::new(s[2], s[5], s[8], 0.),
        glam::Vec4::W,
    )
}

fn swap_yz() -> Mat4 {
    Mat4::from_cols(
        glam::Vec4::new(1., 0., 0., 0.),
        glam::Vec4::new(0., 0., 1., 0.),
        glam::Vec4::new(0., 1., 0., 0.),
        glam::Vec4::new(0., 0., 0., 1.),
    )
}

fn ue_basis_from_view() -> Mat4 {
    Mat4::from_cols(
        glam::Vec4::new(0., 1., 0., 0.),
        glam::Vec4::new(0., 0., 1., 0.),
        glam::Vec4::new(-1., 0., 0., 0.),
        glam::Vec4::new(0., 0., 0., 1.),
    )
}

fn sanitize(matrix: Mat4) -> Mat4 {
    Mat4::from_cols(
        matrix.x_axis.with_w(0.),
        matrix.y_axis.with_w(0.),
        matrix.z_axis.with_w(0.),
        glam::Vec4::from((matrix.w_axis.truncate(), 1.)),
    )
}

fn ue_rotation(rotation_euler: [f32; 3]) -> Mat3 {
    let [roll_degrees, pitch_degrees, yaw_degrees] = rotation_euler;
    let roll = roll_degrees.to_radians();
    let pitch = pitch_degrees.to_radians();
    let yaw = yaw_degrees.to_radians();
    let (sr, cr) = roll.sin_cos();
    let (sp, cp) = pitch.sin_cos();
    let (sy, cy) = yaw.sin_cos();
    Mat3::from_cols(
        Vec3::new(cp * cy, cp * sy, sp),
        Vec3::new(sr * sp * cy - cr * sy, sr * sp * sy + cr * cy, -sr * cp),
        Vec3::new(-(cr * sp * cy + sr * sy), cy * sr - cr * sp * sy, cr * cp),
    )
}

fn ue_local_matrix_without_scale(entity: Option<&Value>) -> Mat4 {
    let Some(entity) = entity else {
        return Mat4::IDENTITY;
    };
    let translation = vector(entity.get("position"), [0.; 3]);
    let rotation = ue_rotation(vector(entity.get("rotation_euler"), [0.; 3]));
    Mat4::from_cols(
        rotation.x_axis.extend(0.),
        rotation.y_axis.extend(0.),
        rotation.z_axis.extend(0.),
        glam::Vec4::new(translation[0], translation[1], translation[2], 1.),
    )
}

fn ue_local_matrix(entity: Option<&Value>) -> Mat4 {
    let Some(entity) = entity else {
        return Mat4::IDENTITY;
    };
    let translation = vector(entity.get("position"), [0.; 3]);
    let scale = vector(entity.get("scale"), [1.; 3]);
    let rotation = ue_rotation(vector(entity.get("rotation_euler"), [0.; 3]));
    Mat4::from_cols(
        rotation.x_axis.extend(0.) * scale[0],
        rotation.y_axis.extend(0.) * scale[1],
        rotation.z_axis.extend(0.) * scale[2],
        glam::Vec4::new(translation[0], translation[1], translation[2], 1.),
    )
}

fn map_stage_point(p: glam::Vec3) -> glam::Vec3 {
    glam::Vec3::new(p.x, p.z, -p.y)
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
enum StageBasis {
    Ue,
    Stage2Y,
    None,
}

impl StageBasis {
    fn apply_transform(self, transform: Mat4) -> Mat4 {
        match self {
            StageBasis::Ue => sanitize(swap_yz() * transform * gltf_to_ue()),
            StageBasis::Stage2Y => stage_to_render() * transform,
            StageBasis::None => transform,
        }
    }

    fn apply_light_transform(self, transform: Mat4) -> Mat4 {
        match self {
            StageBasis::Ue => sanitize(swap_yz() * transform * ue_basis_from_view()),
            StageBasis::Stage2Y => sanitize(stage_to_render() * transform),
            StageBasis::None => sanitize(transform),
        }
    }

    fn apply_point(self, point: glam::Vec3) -> glam::Vec3 {
        match self {
            StageBasis::Ue => glam::Vec3::new(point.x, point.z, point.y),
            StageBasis::Stage2Y => map_stage_point(point),
            StageBasis::None => point,
        }
    }

    fn up(self) -> glam::Vec3 {
        match self {
            StageBasis::Ue => glam::Vec3::Y,
            StageBasis::Stage2Y => glam::Vec3::Y,
            StageBasis::None => glam::Vec3::Z,
        }
    }
}

