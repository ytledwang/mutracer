+#!/bin/zsh
+cd /Users/wangjianzheng/Project/git/mutracer
+log=tools/cloud-service/poc-out/fridge/stage-fridge-local.log
+png=tools/cloud-service/poc-out/fridge/stage-fridge-local.png
