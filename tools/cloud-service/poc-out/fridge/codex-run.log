fn build_scene(source: &Value, assets: &HashMap<String, String>) -> Result<Scene> {
    let mut scene = Scene::new();
    let mut mesh_count = 0;
    for (mesh_id, transform) in visible_mesh_transforms(source) {
        let url = mesh_url(source, &mesh_id).ok_or_else(|| format!("Mesh {mesh_id} has no URL"))?;
        let path = assets
            .get(url)
            .ok_or_else(|| format!("Missing asset for {url}"))?;
        let imported =
            Scene::import_gltf(path).map_err(|e| format!("Importing {url}: {}", e.message))?;
        mesh_count += merge_imported(&mut scene, imported, transform)?;
    }
    if mesh_count == 0 {
        return Err("No visible meshes were imported".into());
    }
    Ok(scene)
}

