/bin/zsh -lc "python3 - <<'PY'
import json
from pathlib import Path
from PIL import Image, ImageChops

def background_color(image):
    corners = (
        image.getpixel((2, 2)),
        image.getpixel((image.width - 3, 2)),
        image.getpixel((2, image.height - 3)),
        image.getpixel((image.width - 3, image.height - 3)),
    )
    return tuple(sorted(pixel[channel] for pixel in corners)[1] for channel in range(3))

def silhouette(image, background, threshold=16):
    difference = ImageChops.difference(image, Image.new('RGB', image.size, background))
    return difference.convert('L').point(lambda value: value > threshold)

final_path = Path('tools/cloud-service/poc-out/fridge/stage-fridge-arch-final.png')
ref_path = Path('tools/cloud-service/poc-out/fridge/ref/fridge-ref-front-329c-1024.png')
metrics_path = Path('tools/cloud-service/poc-out/fridge/arch-metrics.json')
final = Image.open(final_path).convert('RGB')
ref = Image.open(ref_path).convert('RGB')
target_height = min(final.height, ref.height)

def resized(image):
    return image.resize((max(1, round(image.width * target_height / image.height)), target_height), Image.Resampling.LANCZOS)

final = resized(final)
ref = resized(ref)
final_mask = silhouette(final, background_color(final))
ref_mask = silhouette(ref, background_color(ref))
print(json.dumps({
    'final_background_rgb': background_color(final),
    'ref_background_rgb': background_color(ref),
    'final_mask_area': sum(final_mask.getdata()),
    'ref_mask_area': sum(ref_mask.getdata()),
    'arch_metrics': json.loads(metrics_path.read_text()),
}, indent=2))
