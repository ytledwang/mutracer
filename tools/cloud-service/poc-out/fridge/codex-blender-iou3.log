    width = max(1, round(image.width * target_height / image.height))
    return image.resize((width, target_height), Image.Resampling.LANCZOS)

final_metric = resized(final)
ref_metric = resized(ref)

def background(image):
    corners = (image.getpixel((2, 2)), image.getpixel((image.width - 3, 2)), image.getpixel((2, image.height - 3)), image.getpixel((image.width - 3, image.height - 3)))
    return tuple(sorted(pixel[channel] for pixel in corners)[1] for channel in range(3))

def mask(image):
    bg = background(image)
    return sum(max(abs(c - bc) for c, bc in zip(pixel, bg)) > 16 for pixel in image.getdata())

print(json.dumps({
    'metric_background_rgb': {'final': background(final_metric), 'ref': background(ref_metric)},
    'metric_mask_areas': {'final': mask(final_metric), 'ref': mask(ref_metric)},
}, indent=2))
