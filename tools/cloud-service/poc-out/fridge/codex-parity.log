   538	fn stage_camera(
   539	    scene: &Value,
   540	    view: Option<&Value>,
   541	    camera_target: glam::Vec3,
   542	    camera_mode: CameraMode,
   543	) -> Result<StageCamera> {
   544	    let cameras = scene.get("cameras").and_then(Value::as_object);
   545	    let active = view
   546	        .and_then(|view| view.get("active_camera"))
   547	        .and_then(Value::as_str);
   548	    let entity = cameras
   549	        .and_then(|cameras| active.and_then(|id| cameras.get(id)))
   550	        .or_else(|| {
   565	    let height = entity
   566	        .get("frame_size")
   567	        .and_then(Value::as_array)
   568	        .and_then(|v| v.get(1))
   569	        .and_then(Value::as_f64)
   570	        .unwrap_or(1080.) as f32;
   571	    let fov_horizontal = number(settings.get("fov"), 45.).to_radians();
   572	    let fov_vertical = 2. * ((fov_horizontal / 2.).tan() * height / width).atan();
   573	    let mut camera = Camera::default();
   574	    camera.fov = fov_vertical.to_degrees();
   575	    camera.f_stop = if settings.get("dof").and_then(Value::as_bool) == Some(true) {
   576	        number(settings.get("aperture_fstop"), 0.)
   577	    } else {
   578	        0.
   579	    };
   580	    camera.focus_distance = number(settings.get("focal_distance"), 1.).max(0.1);
   581	    camera.world_matrix = match camera_mode {
   582	        CameraMode::Matrix => {
   583	            let mut matrix = local_matrix(Some(entity));
   584	            let p = vector(entity.get("position"), [0.; 3]);
   585	            matrix.w_axis = glam::Vec3::new(p[0], -p[2], p[1]).extend(1.);
   586	            matrix
   587	        }
   588	        CameraMode::LookAt => {
   589	            let p = vector(entity.get("position"), [0.; 3]);
   590	            let eye = glam::Vec3::new(p[0], -p[2], p[1]);
   591	            let mut up = glam::Vec3::Y;
   592	            if eye.normalize_or_zero().dot(up).abs() > 0.999 {
   593	                up = glam::Vec3::Z;
   594	            }
   595	            Mat4::look_at_rh(eye, camera_target, up).inverse()
   596	        }
   597	    }
   598	    .to_cols_array();
   599	
   600	    let post = settings.get("post_processing_settings");
   601	    let mut display = DisplaySettings::default();
   602	    display.tone_mapping = ToneMapping::Agx;
   603	    display.tone_mapping_exposure = number(post.and_then(|p| p.get("exposure")), 1.);
   604	    display.contrast = number(post.and_then(|p| p.get("contrast")), 1.);
   605	    display.saturation = number(post.and_then(|p| p.get("saturation")), 1.);
   606	    display.vignette = number(post.and_then(|p| p.get("vignette")), 0.).clamp(0., 1.);
   607	    Ok(StageCamera { camera, display })
   608	}
