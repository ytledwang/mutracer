   510	fn override_material(
   511	    scene: &Value,
   512	    mesh_id: &str,
   513	    assets: &HashMap<String, String>,
   514	) -> Result<Option<Vec<MaterialOverride>>> {
   515	    let material_ids = scene
   516	        .get("meshes")
   517	        .and_then(Value::as_object)
   518	        .and_then(|meshes| meshes.get(mesh_id))
   519	        .and_then(|mesh| mesh.get("materials"))
   520	        .and_then(Value::as_array)
   521	        .map(|materials| {
   522	            materials
   523	                .iter()
   524	                .filter_map(Value::as_str)
   525	                .collect::<Vec<_>>()
   526	        })
   527	        .unwrap_or_default();
   528	    if material_ids.is_empty() {
   529	        return Ok(None);
   530	    }
   531	    let mut overrides = Vec::new();
   532	    for material_id in material_ids {
   533	        overrides.extend(material_override(scene, assets, material_id)?);
   534	    }
   535	    Ok((!overrides.is_empty()).then_some(overrides))
   536	}
