   169	fn local_matrix(entity: Option<&Value>) -> Mat4 {
   170	    let Some(entity) = entity else {
   171	        return Mat4::IDENTITY;
   172	    };
   173	    let source_translation = vector(entity.get("position"), [0.; 3]);
   174	    let translation = [
   175	        source_translation[0],
   176	        -source_translation[2],
   177	        source_translation[1],
   178	    ];
   179	    let scale = vector(entity.get("scale"), [1.; 3]);
   180	    let degrees = vector(entity.get("rotation_euler"), [0.; 3]);
   181	    let rotation = Quat::from_euler(
   182	        EulerRot::XYZ,
   183	        degrees[0].to_radians(),
   184	        degrees[1].to_radians(),
   185	        degrees[2].to_radians(),
   186	    );
   187	    Mat4::from_scale_rotation_translation(scale.into(), rotation, translation.into())
   188	}
