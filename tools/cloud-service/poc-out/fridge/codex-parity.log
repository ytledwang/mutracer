/// Camera record, identical to `mt_camera_v4` (128 bytes).
#[repr(C)]
#[derive(Clone, Copy, Debug, PartialEq)]
pub struct Camera {
    /// 0 perspective, 1 orthographic.
    pub projection: u32,
    /// Vertical field of view in degrees.
    pub fov: f32,
    pub near_clip: f32,
    pub far_clip: f32,
    pub left: f32,
    pub right: f32,
    pub bottom: f32,
    pub top: f32,
    pub zoom: f32,
    /// 0 disables depth of field.
    pub f_stop: f32,
    pub focus_distance: f32,
    pub sensor_height: f32,
    pub meters_per_unit: f32,
    pub reserved: [u32; 3],
    /// Column-major camera-to-world matrix; the camera looks down -Z.
    pub world_matrix: [f32; 16],
}
const _: () = assert!(std::mem::size_of::<Camera>() == camera_wire::WORDS * WORD_BYTES);
impl Default for Camera {
    /// `mt_camera_v4_default()`: perspective, 45 degrees, no depth of field.
    fn default() -> Self {
        let mut world_matrix = [0.; 16];
        for i in [0, 5, 10, 15] {
            world_matrix[i] = 1.;
        }
        Self {
            projection: 0,
            fov: 45.,
            near_clip: 0.1,
            far_clip: 1000.,
            left: -1.,
            right: 1.,
            bottom: -1.,
            top: 1.,
            zoom: 1.,
            f_stop: 0.,
            focus_distance: 10.,
            sensor_height: 24.,
            meters_per_unit: 1.,
            reserved: [0; 3],
            world_matrix,
        }
    }
}
