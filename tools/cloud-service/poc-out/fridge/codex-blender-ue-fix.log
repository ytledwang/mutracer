#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
import tempfile


def parse_args():
    parser = argparse.ArgumentParser(
        description="Render one stage view with the folded-in Blender final track."
    )
    parser.add_argument("--scene", required=True)
    parser.add_argument("--asset-map", required=True)
    parser.add_argument("--out", required=True)
    parser.add_argument("--view", required=True)
    parser.add_argument("--width", type=int)
    parser.add_argument("--height", type=int)
    parser.add_argument("--spp", type=int, default=32)
    parser.add_argument("--denoise", choices=("0", "1"), default="1")
    parser.add_argument(
        "--blender",
        default=(
            "/Applications/Blender.app/Contents/MacOS/Blender"
            if sys.platform == "darwin"
            else "blender"
        ),
    )
    return parser.parse_args()


def load_asset_map(path):
    with open(path, encoding="utf-8") as stream:
        raw = json.load(stream)
    if isinstance(raw, dict):
        entries = raw.items()
    elif isinstance(raw, list):
        entries = []
        for item in raw:
            if not isinstance(item, dict) or "key" not in item or "value" not in item:
                raise ValueError("Asset map entries require key and value")
            entries.append((item["key"], item["value"]))
    else:
        raise ValueError("Asset map must be an object or an entry list")
    return dict(entries)


def resolve_asset_path(value, assets_root, map_directory):
    candidates = []
    if os.path.isabs(value):
        candidates.append(value)
    else:
        if assets_root:
            candidates.append(os.path.join(assets_root, value))
        candidates.extend(
            (
                os.path.join(map_directory, value),
                os.path.join(map_directory, os.path.basename(value)),
            )
        )
    for candidate in candidates:
        if os.path.isfile(candidate):
            return os.path.abspath(candidate)
    raise FileNotFoundError(value)


def required_urls(scene):
    urls = set()
    for mesh in (scene.get("meshes") or {}).values():
        if mesh.get("url"):
            urls.add(mesh["url"])
    for view in (scene.get("views") or {}).values():
        environment = (scene.get("environments") or {}).get(
            view.get("active_environment")
        )
        texture_id = (environment or {}).get("settings", {}).get("image")
        texture = (scene.get("textures") or {}).get(texture_id)
        texture_url = texture and (texture.get("urls") or texture.get("url"))
        if texture_url:
            urls.add(texture_url)
    return urls


def prepare_assets(scene, map_path, assets_root):
    map_directory = os.path.dirname(os.path.abspath(map_path))
    asset_map = load_asset_map(map_path)
    urls = required_urls(scene)
    missing = sorted(urls - asset_map.keys())
    if missing:
        print(
            f"[assets] {len(missing)} scene URLs absent from asset map; skipping",
            flush=True,
        )
    resolved = {}
    for url in sorted(urls & asset_map.keys()):
        try:
            resolved[url] = resolve_asset_path(
                asset_map[url], assets_root, map_directory
            )
        except FileNotFoundError as error:
            print(f"[assets] {error} unreachable; skipping", flush=True)
    return resolved


def main():
    args = parse_args()
    with open(args.scene, encoding="utf-8") as stream:
        scene = json.load(stream)
    scene = scene.get("scene_json", scene)
    assets = prepare_assets(scene, args.asset_map, os.environ.get("DUAL_TRACK_ASSETS_ROOT"))
    output = os.path.abspath(args.out)
    os.makedirs(os.path.dirname(output) or ".", exist_ok=True)

    assets_path = None
    temporary_directory = tempfile.TemporaryDirectory(prefix="mutracer-final-")
    try:
        assets_path = os.path.join(temporary_directory.name, "assets.json")
        with open(assets_path, "w", encoding="utf-8") as stream:
            json.dump(assets, stream)
        command = [
            args.blender,
            "--background",
            "--factory-startup",
            "--python",
            os.path.abspath(os.path.join(__file__, "..", "blender_inner.py")),
            "--",
            "--scene",
            os.path.abspath(args.scene),
            "--assets-file",
            assets_path,
            "--view",
            args.view,
            "--out",
            output,
            "--spp",
            str(args.spp),
            "--denoise",
            args.denoise,
        ]
        if args.width:
            command.extend(("--width", str(args.width)))
        if args.height:
            command.extend(("--height", str(args.height)))
        subprocess.run(command, check=True)
    finally:
        temporary_directory.cleanup()
    print(output)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
import time

from PIL import Image
from PIL import ImageChops


REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
PREVIEW_BINARY = os.path.join(
    REPO_ROOT, "native/host/target/release/mutracer-render"
)
FINAL_SCRIPT = os.path.join(
    REPO_ROOT, "tools/dual-track/blender/run_blender_final.py"
)
DEFAULT_REF = os.path.join(
    REPO_ROOT,
    "tools/cloud-service/poc-out/fridge/ref/fridge-ref-front-329c-1024.png",
)
BLENDER_BINARY = (
    "/Applications/Blender.app/Contents/MacOS/Blender"
    if sys.platform == "darwin"
    else "blender"
)


def parse_args():
    parser = argparse.ArgumentParser(
        description="Render one stage scene through preview and/or Blender final tracks."
    )
    parser.add_argument("mode", choices=("preview", "final", "both"))
    parser.add_argument("--scene", required=True)
    parser.add_argument("--asset-map", required=True)
    parser.add_argument("--assets-root")
    parser.add_argument("--view", required=True)
    parser.add_argument("--preview-out")
    parser.add_argument("--preview-width", type=int, default=960)
    parser.add_argument("--preview-height", type=int, default=540)
    parser.add_argument("--preview-spp", type=int, default=32)
    parser.add_argument("--final-out")
    parser.add_argument("--final-width", type=int, default=960)
    parser.add_argument("--final-height", type=int, default=540)
    parser.add_argument("--final-spp", type=int, default=64)
    parser.add_argument("--denoise", choices=("0", "1"), default="1")
    parser.add_argument("--compare-out")
    parser.add_argument(
        "--ref",
        default=DEFAULT_REF if os.path.isfile(DEFAULT_REF) else None,
    )
    parser.add_argument("--metrics-out")
    parser.add_argument("--preview-binary", default=PREVIEW_BINARY)
    parser.add_argument("--blender", default=BLENDER_BINARY)
    args = parser.parse_args()
    if args.mode == "preview":
        args.preview_out = args.preview_out or "preview.png"
    elif args.mode == "final":
        args.final_out = args.final_out or "final.png"
    else:
        args.preview_out = args.preview_out or "preview.png"
        args.final_out = args.final_out or "final.png"
    if args.compare_out and not args.metrics_out:
        args.metrics_out = os.path.join(
            os.path.dirname(os.path.abspath(args.compare_out)), "arch-metrics.json"
        )
    return args


def run(command):
    print("+", " ".join(command), flush=True)
    subprocess.run(command, check=True)


def render_preview(args):
    output = os.path.abspath(args.preview_out)
    os.makedirs(os.path.dirname(output) or ".", exist_ok=True)
    command = [
        args.preview_binary,
        "--scene",
        args.scene,
        "--out",
        output,
        "--asset-map",
        args.asset_map,
        "--view",
        args.view,
        "--width",
        str(args.preview_width),
        "--height",
        str(args.preview_height),
        "--samples",
        str(args.preview_spp),
        "--bounces",
        "3",
        "--denoise",
        args.denoise,
        "--timeout-ms",
        "600000",
    ]
    started = time.monotonic()
    run(command)
    return output, time.monotonic() - started


def render_final(args):
    output = os.path.abspath(args.final_out)
    os.makedirs(os.path.dirname(output) or ".", exist_ok=True)
    command = [
        sys.executable,
        FINAL_SCRIPT,
        "--scene",
        args.scene,
        "--asset-map",
        args.asset_map,
        "--out",
        output,
        "--view",
        args.view,
        "--width",
        str(args.final_width),
        "--height",
        str(args.final_height),
        "--spp",
        str(args.final_spp),
        "--denoise",
        args.denoise,
        "--blender",
        args.blender,
    ]
    if args.assets_root:
        env = os.environ.copy()
        env["DUAL_TRACK_ASSETS_ROOT"] = os.path.abspath(args.assets_root)
        started = time.monotonic()
        subprocess.run(command, check=True, env=env)
        return output, time.monotonic() - started
    started = time.monotonic()
    run(command)
    return output, time.monotonic() - started


def brightness_standard_deviation(image):
    gray = image.convert("L")
    histogram = gray.histogram()
    count = sum(histogram)
    mean = sum(index * value for index, value in enumerate(histogram)) / count
    variance = (
        sum(value * (index - mean) ** 2 for index, value in enumerate(histogram)) / count
    )
    return variance ** 0.5


def background_color(image):
    corners = (
        image.getpixel((2, 2)),
        image.getpixel((image.width - 3, 2)),
        image.getpixel((2, image.height - 3)),
        image.getpixel((image.width - 3, image.height - 3)),
    )
    return tuple(
        sorted(pixel[channel] for pixel in corners)[1] for channel in range(3)
    )


def silhouette(image, background, threshold):
    difference = ImageChops.difference(image, Image.new("RGB", image.size, background))
    return difference.convert("L").point(lambda value: value > threshold)


def intersection_over_union(left_mask, right_mask):
    intersection = sum(
        left and right for left, right in zip(left_mask.getdata(), right_mask.getdata())
    )
    union = sum(
        left or right for left, right in zip(left_mask.getdata(), right_mask.getdata())
    )
    return intersection / union if union else 1.0

