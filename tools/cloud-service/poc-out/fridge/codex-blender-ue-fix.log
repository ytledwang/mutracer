+    }
+    if mesh_name in door_edge_meshes and (
+        "钣金喷粉" in name or "Plastic_Coated" in name or "Plastic_Rough" in name or name == "11"
+    ):
+        color = [0.04, 0.04, 0.045]
+        roughness = 0.45
+        metalness = 0.12
+
+    textures = {}
