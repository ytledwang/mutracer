    fn walk_models(
        models: &Map<String, Value>,
        id: &str,
        mesh_id: &str,
        visited: &mut std::collections::BTreeSet<String>,
    ) -> Option<String> {
        if !visited.insert(id.into()) {
            return None;
        }
        let entity = models.get(id)?;
        if entity.get("type").and_then(Value::as_str) == Some("model")
            && entity.get("mesh").and_then(Value::as_str) == Some(mesh_id)
        {
            return entity
                .get("name")
                .and_then(Value::as_str)
                .map(str::to_string);
        }
        for child in entity
            .get("children")
            .and_then(Value::as_array)
            .into_iter()
            .flatten()
        {
            if let Some(child) = child.as_str() {
                if let Some(name) = walk_models(models, child, mesh_id, visited) {
                    return Some(name);
                }
            }
        }
        None
    }

    let models = scene
        .get("models")
        .and_then(Value::as_object)
        .cloned()
        .unwrap_or_default();
    for id in models.keys() {
        let mut visited = std::collections::BTreeSet::new();
        if let Some(name) = walk_models(&models, id, mesh_id, &mut visited) {
            return Some(name);
        }
    }
    None
}

fn load_texture(path: &Path, rgba32f: bool) -> Result<Texture> {
    let image = image::open(path).map_err(|e| format!("Loading {}: {e}", path.display()))?;
    if rgba32f {
        let rgba = image.into_rgba32f();
        let pixels: Vec<f32> = rgba
            .pixels()
            .flat_map(|pixel| [pixel.0[0], pixel.0[1], pixel.0[2], pixel.0[3]])
            .collect();
        Ok(Texture {
            pixels: TexturePixels::Rgba32F(pixels.into()),
            width: rgba.width(),
            height: rgba.height(),
            ..Texture::rgba8(1, 1, [0; 4])
        })
    } else {
        let rgba8 = image.into_rgba8();
        let pixels = rgba8.pixels().flat_map(|p| p.0).collect::<Vec<_>>();

